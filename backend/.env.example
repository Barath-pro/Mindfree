PORT=5000
CLIENT_URL=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/mindfree
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
GOOGLE_API_KEY=your-google-api-key
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_MODERATION_MODEL=gemini-2.5-flash-lite
GOOGLE_TRANSCRIPTION_MODEL=gemini-2.5-flash-lite
MODERATION_WARNING_THRESHOLD=0.5
MODERATION_BLOCK_THRESHOLD=0.8
WARNINGS_BEFORE_TEMP_BLOCK=3
TEMP_BLOCK_MINUTES=15
MAX_VOICE_FILE_SIZE=10485760
LOG_LEVEL=info
